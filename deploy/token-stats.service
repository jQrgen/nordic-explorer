[Unit]
Description=Nordic Crypto Explorer Nexa token list (explorer.nexa.org Token Tracker)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/explorer-token-stats/token-stats.mjs /var/www/explorer-data/nexa-tokens.json
User=www-data
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/www/explorer-data
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
