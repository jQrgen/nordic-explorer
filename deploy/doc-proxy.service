[Unit]
Description=Nordic Crypto Explorer token document pass-through proxy
After=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/explorer-doc-proxy/doc-proxy.mjs
Environment=PORT=8790
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
Restart=on-failure

[Install]
WantedBy=multi-user.target
